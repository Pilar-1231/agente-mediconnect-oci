        "jsCode": "// Mapeo dinámico de extensiones a Mime Types comunes\nconst mimeMap = {\n  pdf: 'application/pdf',\n  txt: 'text/plain',\n  csv: 'text/csv',\n  docx: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',\n  doc: 'application/msword',\n  json: 'application/json'\n};\n\nfor (const item of $input.all()) {\n  if (item.binary && item.binary.data) {\n    const ext = item.binary.data.fileExtension?.toLowerCase();\n    \n    // Si GitHub nos devolvió octet-stream, lo corregimos según la extensión\n    if (item.binary.data.mimeType === 'application/octet-stream' && ext && mimeMap[ext]) {\n      item.binary.data.mimeType = mimeMap[ext];\n    }\n  }\n}\n\nreturn $input.all();"
